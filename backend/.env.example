DATABASE_URL=sqlite:///./govrisk.db
AUTH_DATABASE_URL=sqlite:///./auth.db
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# AI / LLM early-warning layer
# -------------------------------------------------------------------
# APP_ENV: development | production (production enforces secure config)
APP_ENV=development

# `AI_PROVIDER` may be left EMPTY to run the deterministic early-warning
# engine only (no external calls). Supported values: openai | openrouter |
# azure | custom | anthropic | claude.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional custom endpoint. Defaults per provider when empty.
AI_API_BASE=

# LLM request safety bounds (bounded - never infinite retries/timeout)
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# Cached-analysis freshness (hours) + alert dedupe window (hours)
AI_ANALYSIS_TTL_HOURS=6
AI_ALERT_DEDUP_HOURS=168
